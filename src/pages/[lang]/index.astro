---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { content, instructors, businessEmail, type Lang } from '../../data/content';
export function getStaticPaths() { return ['sk', 'hu'].map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = content[lang];
const navTargets = ['o-nas', 'kurzy', 'instruktori', 'kontakt'];
const mapQuery = encodeURIComponent('Autoškola Tymy, Nábrežná 5779, Nové Zámky, Slovakia');
const mapUrl = `https://www.google.com/maps?q=${mapQuery}&output=embed&hl=${lang}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;
---
<Layout lang={lang}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="container header-inner">
      <a href={`/${lang}/`} class="brand" aria-label="Autoškola Tymy">
        <img src="/images/logo.webp" alt="Autoškola Tymy" width="148" height="66" fetchpriority="high" />
      </a>
      <nav class="desktop-nav" aria-label={t.navLabel}>
        {t.nav.map((label, i) => <a href={`#${navTargets[i]}`}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <div class="language-switch" role="group" aria-label={t.language}>
          <a href="/sk/" lang="sk" aria-label="Slovenčina" aria-current={lang === 'sk' ? 'page' : undefined} class:list={{ active: lang === 'sk' }}>SK</a>
          <span aria-hidden="true">/</span>
          <a href="/hu/" lang="hu" aria-label="Magyar" aria-current={lang === 'hu' ? 'page' : undefined} class:list={{ active: lang === 'hu' }}>HU</a>
        </div>
        <a class="button button-small header-cta" href="#prihlasenie">{t.apply}<Icon name="diagonal" size={16} /></a>
        <a class="header-facebook" href="https://www.facebook.com/autoskolatymy" target="_blank" rel="noopener noreferrer" aria-label={t.facebook}><Icon name="facebook" size={20} /></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label={t.menu} data-open-label={t.menu} data-close-label={t.closeMenu}>
          <span></span><span></span>
        </button>
      </div>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label={t.navLabel} hidden>
      {t.nav.map((label, i) => <a href={`#${navTargets[i]}`}>{label}<Icon name="diagonal" size={18} /></a>)}
      <a href="#prihlasenie" class="mobile-apply">{t.apply}<Icon name="arrow" size={18} /></a>
    </nav>
  </header>

  <main id="main">
    <section class="hero-wide" aria-labelledby="hero-title">
      <div class="hero-route" aria-hidden="true">
        <svg viewBox="0 0 1440 560" fill="none" preserveAspectRatio="none"><path class="road-surface" d="M-110 520C120 570 230 520 365 528S620 535 745 377S1075 225 1545 292" /><path class="road-markings" d="M-110 520C120 570 230 520 365 528S620 535 745 377S1075 225 1545 292" /></svg>
      </div>
      <div class="hero container">
      <div class="hero-content">
        <p class="eyebrow"><span class="red-dot"></span>{t.eyebrow}</p>
        <h1 id="hero-title">{t.headline[0]}<br /><span>{t.headline[1]}</span></h1>
        <p class="hero-description">{t.intro}</p>
        <div class="hero-controls">
          <div class="hero-actions">
            <a class="button" href="#prihlasenie">{t.heroCta}<Icon name="arrow" size={20} /></a>
            <a class="text-link" href="#kurzy">{t.secondaryCta}<Icon name="diagonal" size={16} /></a>
          </div>
          <a class="button hero-contact-button" href="#kontakt">{t.nav[3]}<Icon name="phone" size={17} /></a>
        </div>
      </div>
      <div class="hero-stage" data-parallax-stage>
        <button class="motion-toggle" type="button" aria-label={t.pauseMotion} title={t.pauseMotion} aria-pressed="false" data-pause-label={t.pauseMotion} data-resume-label={t.resumeMotion} hidden>
          <svg class="pause-icon" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 1h3v10H2zm5 0h3v10H7z" /></svg>
          <svg class="play-icon" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="m3 1 8 5-8 5z" /></svg>
        </button>
        <div class="stage-grid" aria-hidden="true"></div>
        <div class="stage-heading"><span>{t.heroCarLabel}</span><strong>Hyundai i20<span class="stage-cross">+</span></strong></div>
        <div class="stage-letter" aria-hidden="true">B</div>
        <div class="hero-cars-wrap">
          <svg class="mobile-road" viewBox="0 0 400 300" width="400" height="300" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <path class="road-surface" d="M-60 205C10 205 35 270 130 260S250 175 320 170S400 205 460 180" />
            <path class="road-markings" d="M-60 205C10 205 35 270 130 260S250 175 320 170S400 205 460 180" />
          </svg>
          <img class="hero-cars" src="/images/hero-cars-v2.webp" alt={t.heroCarsAlt} width="1536" height="1024" fetchpriority="high" />
        </div>
        <a class="stage-caption" href="#prihlasenie"><span class="stage-category" aria-hidden="true">B</span><span>{t.heroStageTitle}<small>{t.heroStageDetail}</small></span><Icon name="diagonal" size={22} /></a>
      </div>
      </div>
    </section>

    <div class="container trust-strip">
      {t.trust.map(item => <div class="trust-item"><div class="trust-icon"><Icon name={item.icon} size={27} /></div><div><strong>{item.title}</strong><p>{item.text}</p></div></div>)}
    </div>

    <section class="section container" id="kurzy" aria-labelledby="courses-title">
      <div class="section-heading reveal">
        <div><p class="eyebrow">{t.servicesLabel}</p><h2 id="courses-title">{t.servicesTitle}</h2></div>
      </div>
      <div class="courses-grid">
        <article class="course-main reveal">
          <div class="course-top"><span class="course-tag">{t.mainCourseTag}</span><Icon name="wheel" size={46} /></div>
          <h3>{t.mainCourse}</h3>
          <p>{t.mainCourseDesc}</p>
          <ul class="course-includes">{[...t.courseIncludes, t.instalments].map(item => <li><Icon name="check" size={18} /><span>{item}</span></li>)}</ul>
          <div class="course-pricing"><div class="course-price">990 <span>€</span></div></div>
          <a class="button button-white" href="#prihlasenie">{t.mainCourseCta}<Icon name="arrow" size={20} /></a>
        </article>
        <div class="course-secondary">
          <article class="course-small reveal">
            <div class="small-course-title"><h3>{t.refresher}</h3><Icon name="practice" size={32} /></div>
            <p>{t.refresherDesc}</p>
            <div class="small-course-bottom"><div class="small-price">30 € <span>{t.perHour}</span></div></div>
          </article>
          <article class="course-small reveal">
            <div class="small-course-title"><h3>{t.retraining}</h3><Icon name="retraining" size={32} /></div>
            <p>{t.retrainingDesc}</p>
            <a class="text-link" href="#kontakt">{t.retrainingCta}<Icon name="arrow" size={18} /></a>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section" id="o-nas" aria-labelledby="about-title">
      <div class="container about-grid">
        <figure class="about-photo reveal"><img src="/images/ucebna.webp" alt={t.classroomAlt} width="1400" height="1050" loading="lazy" /><figcaption><span class="red-dot"></span>{t.classroomCaption}</figcaption></figure>
        <div class="about-content reveal"><p class="eyebrow">{t.aboutLabel}</p><h2 id="about-title">{t.aboutTitle}</h2><p>{t.aboutText}</p><p>{t.aboutText2}</p><a class="text-link" href="#instruktori">{t.nav[2]}<Icon name="arrow" size={20} /></a></div>
      </div>
    </section>

    <section class="section container" id="instruktori" aria-labelledby="team-title">
      <div class="section-heading reveal"><div><p class="eyebrow">{t.teamLabel}</p><h2 id="team-title">{t.teamTitle}</h2></div></div>
      <div class="team-grid">
        {instructors.map((person, index) => <article class="instructor reveal">
          <div class="instructor-copy"><span class="person-index">0{index + 1}/{person.name.split(' ')[0]}</span><div><p class="instructor-role">{t.instructor}</p><h3>{person.name}</h3><a href={`tel:${person.tel}`}><Icon name="phone" size={18} />{person.phone}</a></div></div>
          <span class="instructor-orbit" aria-hidden="true"></span>
          <div class="portrait-stack">
            <img class="portrait-outline" src={`/images/${person.image}.webp`} alt="" aria-hidden="true" width={person.width} height={person.height} loading="lazy" />
            <img class="portrait-photo" src={`/images/${person.image}.webp`} alt={`${person.name}, ${t.portraitAlt}`} width={person.width} height={person.height} loading="lazy" />
          </div>
        </article>)}
      </div>
    </section>

    <section class="fleet-section container" id="vozovy-park" aria-labelledby="fleet-title">
      <div class="section-heading reveal"><div><p class="eyebrow">{t.fleetLabel}</p><h2 id="fleet-title">{t.fleetTitle}</h2></div><p class="section-intro">{t.fleetIntro}</p></div>
      <div class="fleet-grid">
        <figure class="fleet-image fleet-primary reveal"><img src="/images/hyundai.webp" alt={t.fleetCarAlt} width="1600" height="1067" loading="lazy" /><figcaption><span>{t.fleetCar}</span><Icon name="diagonal" size={20} /></figcaption></figure>
        <figure class="fleet-image reveal"><img src="/images/cvicisko.webp" alt={t.fleetGroundAlt} width="1200" height="800" loading="lazy" /><figcaption><span>{t.fleetGround}</span><Icon name="diagonal" size={20} /></figcaption></figure>
      </div>
    </section>

    <section class="signup-section" id="prihlasenie" aria-labelledby="signup-title">
      <div class="container">
        <div class="section-heading reveal"><div><p class="eyebrow">{t.signupLabel}</p><h2 id="signup-title">{t.signupTitle}</h2></div><p class="section-intro">{t.signupIntro}</p></div>
        <ol class="steps">{t.steps.map((step, i) => <li class="reveal"><span class="step-number">0{i + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
        <div class="downloads reveal">
          {[{ title: t.application, file: 'prihlaska.pdf' }, { title: t.request, file: 'ziadost.pdf' }].map(doc => <a href={`/documents/${doc.file}`} download class="download-link"><span class="file-icon"><Icon name="file" size={28} /></span><span><strong>{doc.title}</strong><small>{t.download}</small></span><Icon name="download" size={22} /></a>)}
        </div>
        <p class="pdf-note">{t.pdfLanguage}</p>
        <aside class="education-note" aria-labelledby="education-title"><Icon name="check" size={26} /><div><h3 id="education-title">{t.educationTitle}</h3><p>{t.educationText}</p></div></aside>
      </div>
    </section>

    <aside class="tests-strip container reveal" aria-labelledby="tests-title"><div class="tests-icon"><Icon name="retraining" size={44} /></div><div><p class="tests-label">{t.testsLabel}</p><h2 id="tests-title">{t.testsTitle}</h2><p>{t.testsText}</p></div><a class="button button-white" href="https://www.minv.sk/?testy" target="_blank" rel="noopener noreferrer">{t.testsCta}<Icon name="diagonal" size={19} /></a></aside>

    <section class="contact-section" id="kontakt" aria-labelledby="contact-title">
      <div class="container contact-grid">
        <div class="contact-copy reveal"><p class="eyebrow">{t.contactLabel}</p><h2 id="contact-title">{t.contactTitle}</h2><p class="contact-intro">{t.contactIntro}</p>
          <div class="contact-phones">{instructors.map(person => <a href={`tel:${person.tel}`}><span>{person.name}</span><strong>{person.phone}</strong><Icon name="diagonal" size={22} /></a>)}</div>
          <a class="contact-email" href={`mailto:${businessEmail}`}><Icon name="mail" size={21} /><span><small>E-MAIL</small><strong>{businessEmail}</strong></span><Icon name="diagonal" size={19} /></a>
          <div class="contact-address"><div><p class="address-label">{t.addressLabel}</p><address>Nábrežná 5779<br />Nové Zámky</address></div><a class="text-link" href={directionsUrl} target="_blank" rel="noopener noreferrer">{t.directions}<Icon name="diagonal" size={18} /></a></div>
          <a class="facebook-link" href="https://www.facebook.com/autoskolatymy" target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={18} />{t.facebook}<Icon name="diagonal" size={16} /></a>
        </div>
        <div class="contact-visual reveal"><div class="map-frame">
          <iframe src={mapUrl} title={t.mapTitle} width="600" height="400" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div><figure class="contact-place"><img src="/images/premises-v2.webp" alt={t.premisesAlt} width="1536" height="1024" loading="lazy" /></figure></div>
      </div>
    </section>
  </main>
  <footer class="site-footer" id="pata">
    <div class="container footer-main">
      <div class="footer-identity">
        <a href={`/${lang}/`} class="footer-brand"><img src="/images/logo.webp" alt="Autoškola Tymy" width="136" height="61" loading="lazy" /></a>
        <p>{t.footerText}</p>
      </div>
      <div class="footer-contacts">
        <a href={`mailto:${businessEmail}`}><Icon name="mail" size={16} />{businessEmail}</a>
        <a href="https://www.facebook.com/autoskolatymy" target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={16} />{t.facebook}<Icon name="diagonal" size={13} /></a>
      </div>
    </div>
    <div class="container footer-bottom">
      <span>© {new Date().getFullYear()} Autoškola Tymy. {t.footerRights}</span>
      <span>{lang === 'hu' ? 'Érsekújvár · 1991 óta' : 'Nové Zámky · od 1991'}</span>
      <a class="text-link" href="#hore">{t.top}<span class="up-arrow"><Icon name="arrow" size={16} /></span></a>
    </div>
  </footer>

  <script>
    const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('#mobile-nav');
    function closeMenu() {
      if (!menu || !nav) return;
      menu.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-label', menu.dataset.openLabel || 'Menu');
      nav.hidden = true;
    }
    menu?.addEventListener('click', () => {
      if (!nav) return;
      const open = menu.getAttribute('aria-expanded') !== 'true';
      menu.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-label', (open ? menu.dataset.closeLabel : menu.dataset.openLabel) || 'Menu');
      nav.hidden = !open;
    });
    nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
    window.matchMedia('(min-width: 1051px)').addEventListener('change', event => { if (event.matches) closeMenu(); });

    // Center the offer below the sticky header, excluding section padding.
    function positionCourses(smooth = false) {
      const section = document.querySelector<HTMLElement>('#kurzy');
      const heading = section?.querySelector<HTMLElement>('.section-heading');
      const grid = section?.querySelector<HTMLElement>('.courses-grid');
      if (!section || !heading || !grid) return;
      section.querySelectorAll('.will-reveal').forEach(item => item.classList.remove('will-reveal'));
      const headerHeight = document.querySelector('.site-header')?.getBoundingClientRect().height || 0;
      const sectionTop = section.getBoundingClientRect().top + window.scrollY;
      const top = sectionTop + heading.offsetTop;
      const bottom = sectionTop + grid.offsetTop + grid.offsetHeight;
      const available = window.innerHeight - headerHeight - 32;
      const inset = headerHeight + 16 + Math.max(0, (available - (bottom - top)) / 2);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: Math.max(0, top - inset), behavior: smooth && !reduce ? 'smooth' : 'instant' });
    }
    document.querySelectorAll<HTMLAnchorElement>('a[href="#kurzy"]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        closeMenu();
        if (location.hash !== '#kurzy') history.pushState(null, '', '#kurzy');
        requestAnimationFrame(() => positionCourses(true));
      });
    });
    window.addEventListener('hashchange', () => { if (location.hash === '#kurzy') positionCourses(true); });
    const alignInitialCourseLink = () => {
      document.fonts.ready.then(() => { if (location.hash === '#kurzy') positionCourses(); });
    };
    if (document.readyState === 'complete') alignInitialCourseLink();
    else window.addEventListener('load', alignInitialCourseLink, { once: true });

    // Content remains visible when JavaScript is disabled or observers are unavailable.
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.remove('will-reveal'); observer.unobserve(entry.target); }
      }), { threshold: 0.08 });
      document.querySelectorAll<HTMLElement>('.reveal').forEach(element => {
        if (element.getBoundingClientRect().top > window.innerHeight) element.classList.add('will-reveal');
        observer.observe(element);
      });
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const motionToggle = document.querySelector<HTMLButtonElement>('.motion-toggle');
    if (motionToggle) {
      motionToggle.hidden = false;
      motionToggle.addEventListener('click', () => {
        const paused = document.documentElement.classList.toggle('motion-paused');
        motionToggle.setAttribute('aria-pressed', String(paused));
        const label = (paused ? motionToggle.dataset.resumeLabel : motionToggle.dataset.pauseLabel) || '';
        motionToggle.setAttribute('aria-label', label);
        motionToggle.title = label;
      });
    }

    const stage = document.querySelector<HTMLElement>('[data-parallax-stage]');
    if (stage && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let pointerFrame = 0;
      stage.addEventListener('pointermove', event => {
        if (reducedMotion.matches || document.documentElement.classList.contains('motion-paused')) return;
        cancelAnimationFrame(pointerFrame);
        const bounds = stage.getBoundingClientRect();
        const x = ((event.clientX - bounds.left) / bounds.width - .5) * 14;
        const y = ((event.clientY - bounds.top) / bounds.height - .5) * 9;
        pointerFrame = requestAnimationFrame(() => {
          stage.style.setProperty('--pointer-x', `${x}px`);
          stage.style.setProperty('--pointer-y', `${y}px`);
        });
      });
      stage.addEventListener('pointerleave', () => {
        cancelAnimationFrame(pointerFrame);
        stage.style.setProperty('--pointer-x', '0px');
        stage.style.setProperty('--pointer-y', '0px');
      });
    }
    if ('IntersectionObserver' in window) {
      const motionObserver = new IntersectionObserver(entries => entries.forEach(entry => {
        entry.target.classList.toggle('is-offscreen', !entry.isIntersecting);
      }), { rootMargin: '80px' });
      document.querySelectorAll('.hero-wide').forEach(element => motionObserver.observe(element));
    }
  </script>
</Layout>
