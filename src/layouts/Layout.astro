---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/courses.css';
import '../styles/signup.css';
import '../styles/contact.css';
import '../styles/footer.css';
import { content, businessEmail, instructors, type Lang } from '../data/content';
import { business } from '../data/business';
import { withBase } from '../lib/paths';
interface Props { lang: Lang; title?: string; description?: string; noindex?: boolean; alternatePaths?: Record<Lang, string>; }
const { lang, title = content[lang].title, description = content[lang].description, noindex = false, alternatePaths = { sk: '/sk/', hu: '/hu/' } } = Astro.props;
const base = Astro.site!;
const canonical = new URL(withBase(Astro.url.pathname), base);
const indexable = process.env.INDEXABLE === 'true' && !noindex;
const businessSchema = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  '@id': new URL(withBase('/#business'), base).href,
  name: 'Autoškola Tymy', url: new URL(withBase(`/${lang}/`), base).href,
  legalName: business.legalName,
  identifier: business.ico,
  vatID: business.vatId,
  image: new URL(withBase('/images/hero.webp'), base).href,
  logo: new URL(withBase('/images/logo.webp'), base).href,
  telephone: instructors.map(({ tel }) => tel),
  email: businessEmail,
  address: { '@type': 'PostalAddress', streetAddress: business.premisesStreet, addressLocality: 'Nové Zámky', addressCountry: 'SK' },
  sameAs: ['https://www.facebook.com/autoskolatymy'],
  foundingDate: '1991',
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    <link rel="canonical" href={canonical} />
    {!noindex && <>
      <link rel="alternate" hreflang="sk" href={new URL(withBase(alternatePaths.sk), base)} />
      <link rel="alternate" hreflang="hu" href={new URL(withBase(alternatePaths.hu), base)} />
      <link rel="alternate" hreflang="x-default" href={new URL(withBase(alternatePaths.sk), base)} />
    </>}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Autoškola Tymy" />
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : 'hu_HU'} />
    <meta property="og:image" content={new URL(withBase(`/images/social-hero-${lang}.jpg`), base)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={content[lang].socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <noscript><style>*, *::before, *::after { animation: none !important; }</style></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </head>
  <body id="hore">
    <slot />
  </body>
</html>
