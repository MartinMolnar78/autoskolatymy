---
import Layout from '../../layouts/Layout.astro';
import { business, privacyLabels, privacyPaths } from '../../data/business';
import { businessEmail, content, type Lang } from '../../data/content';
import { privacy } from '../../data/privacy';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return (['sk', 'hu'] as const).map(lang => ({
    params: { lang, privacy: privacyPaths[lang].split('/')[2] },
  }));
}

const lang = Astro.params.lang as Lang;
const other = lang === 'sk' ? 'hu' : 'sk';
const t = privacy[lang];
const home = withBase(`/${lang}/`);
const githubPreview = Astro.site?.hostname.endsWith('.github.io');
const hostingPolicyUrl = githubPreview
  ? 'https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement'
  : 'https://www.cloudflare.com/privacypolicy/';
const hostingTransfersUrl = githubPreview
  ? hostingPolicyUrl + '#international-transfers'
  : 'https://www.cloudflare.com/cloudflare-customer-dpa/';
---

<Layout lang={lang} title={`${privacyLabels[lang]} | Autoškola Tymy`} description={t.scope} alternatePaths={privacyPaths}>
  <a class="skip-link" href="#main">{content[lang].skip}</a>
  <header class="policy-header">
    <div class="container policy-nav">
      <a class="brand" href={home}><img src={withBase('/images/logo.webp')} width="134" height="60" alt="Autoškola Tymy" /></a>
      <nav aria-label={content[lang].navLabel}>
        <a href={home}>{t.back}</a>
        <a href={withBase(privacyPaths[other])} hreflang={other} lang={other}>{other === 'hu' ? 'Magyar' : 'Slovenčina'}</a>
      </nav>
    </div>
  </header>
  <main class="container policy" id="main">
    <h1>{privacyLabels[lang]}</h1>
    <p class="policy-intro">{t.scope}</p>
    <section>
      <h2>{t.controller}</h2>
      <address>
        <strong>{business.legalName}</strong><br />
        {t.registered}: {business.registeredStreet}, {business.registeredTown}<br />
        IČO {business.ico}<br />
        <a href={`mailto:${businessEmail}`}>{businessEmail}</a>
      </address>
    </section>
    <section>
      <h2>{t.contact}</h2>
      <p>{t.contactUse}</p>
      <p>{t.contactRetention}</p>
    </section>
    <section>
      <h2>{t.hosting}</h2>
      <p>{githubPreview ? t.github : t.cloudflare}</p>
      <p>{t.hostingBasis}</p>
      <a href={hostingPolicyUrl}>{t.hostingPolicy}</a>
    </section>
    <section id="mapa">
      <h2>{t.map}</h2>
      <p>{t.mapUse}</p>
      <p>{t.mapChoice}</p>
      <ul class="policy-links">
        <li><a href={home + '#kontakt'}>{t.mapSettings}</a></li>
        <li><a href={`https://policies.google.com/privacy?hl=${lang}`}>{t.googlePolicy}</a></li>
        <li><a href={`https://policies.google.com/technologies/cookies?hl=${lang}`}>{t.googleCookies}</a></li>
      </ul>
      <p>{t.external}</p>
    </section>
    <section>
      <h2>{t.recipients}</h2>
      <p>{t.recipientsUse}</p>
      <ul class="policy-links">
        <li><a href={`https://policies.google.com/privacy/frameworks?hl=${lang}`}>{t.googleTransfers}</a></li>
        <li><a href={hostingTransfersUrl}>{t.hostTransfers}</a></li>
      </ul>
    </section>
    <section>
      <h2>{t.rights}</h2>
      <p>{t.rightsUse}</p>
      <p>{t.complaint}</p>
      <p><a href="https://www.dataprotection.gov.sk/sk/">{t.authority}</a></p>
      <p>{t.automated}</p>
    </section>
    <a class="policy-back" href={home}>{t.back}</a>
  </main>
</Layout>

<style>
  .policy-header { border-bottom: 1px solid var(--line); }
  .policy-nav { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; padding-block: 12px; }
  .policy-nav nav { display: flex; gap: 18px; }
  .policy-nav nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; font-weight: 750; }
  .policy { max-width: 760px; padding-block: 50px 72px; }
  .policy h1 { font-size: clamp(36px, 6vw, 58px); letter-spacing: -.055em; line-height: 1.08; margin-bottom: 20px; }
  .policy-intro { font-size: 16px; }
  .policy section { margin-top: 25px; padding-top: 22px; border-top: 1px solid var(--line); }
  .policy h2 { font-size: 22px; letter-spacing: -.025em; line-height: 1.3; margin-bottom: 10px; }
  .policy address { font-style: normal; }
  .policy p + p { margin-top: 12px; }
  .policy p { color: #434a41; }
  .policy a { color: #a52721; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .policy-links { padding-inline-start: 20px; }
  .policy-back { display: inline-flex; align-items: center; min-height: 44px; margin-top: 20px; font-weight: 750; }
</style>
